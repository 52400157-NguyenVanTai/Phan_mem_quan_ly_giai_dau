<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Esport Manager</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="ak-theme notion-theme">
    <div class="notion-bg-signal"></div>

    @if (Session["UserId"] != null)
    {
        <nav class="ak-navbar notion-navbar">
            <a href="@Url.Action("Index", "Dashboard")" class="ak-nav-brand notion-nav-brand">Esport Manager</a>

            <ul class="ak-nav-menu notion-nav-menu">
                <li>@Html.ActionLink("Trang chu", "Index", "Dashboard", new { area = "" }, new { @class = "ak-nav-link notion-nav-link" })</li>
                <li>@Html.ActionLink("Giai dau", "Index", "GiaiDau", new { area = "" }, new { @class = "ak-nav-link notion-nav-link" })</li>
                <li>@Html.ActionLink("Doi", "Index", "Doi", new { area = "" }, new { @class = "ak-nav-link notion-nav-link" })</li>
                <li>@Html.ActionLink("Yeu cau", "Index", "YeuCau", new { area = "" }, new { @class = "ak-nav-link notion-nav-link" })</li>
                <li>@Html.ActionLink("Thong bao", "Index", "ThongBao", new { area = "" }, new { @class = "ak-nav-link notion-nav-link" })</li>
                <li>@Html.ActionLink("Trong tai", "Index", "TrongTai", new { area = "" }, new { @class = "ak-nav-link notion-nav-link" })</li>
            </ul>

            <div class="dropdown">
                <button class="ak-btn-pill notion-user-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="notion-user-initial">@Session["Username"].ToString().Substring(0, 1).ToUpper()</span>
                    <span>@Session["Username"]</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end notion-dropdown">
                    <li>@Html.ActionLink("Thong tin ca nhan", "Index", "Profile", new { area = "" }, new { @class = "dropdown-item" })</li>
                    <li>@Html.ActionLink("Ho so thi dau", "Index", "HoSoThiDau", new { area = "" }, new { @class = "dropdown-item" })</li>
                    <li>@Html.ActionLink("Doi cua toi", "Index", "DoiCuaToi", new { area = "" }, new { @class = "dropdown-item" })</li>
                    <li>@Html.ActionLink("Dong gop y kien", "Index", "DongGopYKien", new { area = "" }, new { @class = "dropdown-item" })</li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><button class="dropdown-item notion-danger-text" type="button" id="logoutButton">Dang xuat</button></li>
                </ul>
            </div>
        </nav>
    }

    <main class="ak-container notion-shell">
        @RenderBody()
    </main>

    <footer class="notion-footer">
        <p>&copy; @DateTime.Now.Year - Esport Manager Command Center</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/app-auth.js?v=@DateTime.Now.Ticks"></script>
    <script>
        $(function () {
            $(document).on("click", "[data-notion-loading]", function () {
                $(this).addClass("notion-is-loading");
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
