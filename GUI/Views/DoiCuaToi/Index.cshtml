@{
    ViewBag.Title = "Đội của tôi";
}

<section class="team-page">
    <div id="doiMessage"></div>
    <div class="team-hero">
        <div>
            <p class="eyebrow">ĐỘI CỦA TÔI</p>
            <h1>Các đội bạn tạo hoặc đã tham gia</h1>
            <p class="text-muted">Bấm vào đội để quản lý theo quyền của bạn trong đội đó.</p>
        </div>
        @Html.ActionLink("Tạo đội mới", "Index", "Doi", null, new { @class = "btn btn-primary" })
    </div>
    <div id="myTeamList" class="team-grid"></div>
</section>

@section scripts {
    <script src="~/Scripts/app-doi.js"></script>
}
